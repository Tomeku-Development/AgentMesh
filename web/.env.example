# PostgreSQL connection string used by Drizzle ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The site renders with sensible fallback data when this is unset.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmesh"

# ---------------------------------------------------------------------------
# Authentication (BetterAuth)
# ---------------------------------------------------------------------------
# Long random string used to sign sessions.
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Public base URL of the app (used for auth callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Media storage — S3-compatible (Cloudflare R2 or Amazon S3)
# ---------------------------------------------------------------------------
S3_BUCKET="agentmesh-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2: "auto"  |  AWS: e.g. "us-east-1"
S3_REGION="auto"
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Amazon S3: leave blank to use the default AWS endpoint
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# Public base URL objects are served from (R2 public domain, CloudFront, or custom domain)
S3_PUBLIC_BASE_URL="https://media.example.com"
# Set "true" for R2 / MinIO style path-based addressing
S3_FORCE_PATH_STYLE="true"
# Optional canned ACL for AWS (e.g. "public-read"); R2 ignores this
# S3_ACL="public-read"
