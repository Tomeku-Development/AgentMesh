# PostgreSQL connection string used by Drizzle ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The site renders with sensible fallback data when this is unset.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmesh"

# ---------------------------------------------------------------------------
# Authentication (BetterAuth)
# ---------------------------------------------------------------------------
# Long random string used to sign sessions.
BETTER_AUTH_SECRET="generate-a-long-random-string"
# Public base URL of the app (used for auth callbacks).
BETTER_AUTH_URL="http://localhost:3000"
# Extra allowed browser origins for auth POSTs, comma-separated.
# Production example: "https://www.agentmesh.world,https://agentmesh.world"
BETTER_AUTH_TRUSTED_ORIGINS=""

# Public canonical site URL. Used as an auth fallback when BETTER_AUTH_URL is unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Payments (optional until checkout is live)
# ---------------------------------------------------------------------------
# Default checkout provider. Supported: xendit, stripe, polar.
PAYMENT_DEFAULT_PROVIDER="xendit"
PAYMENT_PRO_AMOUNT="9900"
PAYMENT_PRO_CURRENCY="USD"

# Xendit is the primary gateway. Used by /api/checkout when provider=xendit.
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""

# Stripe fallback. STRIPE_PRO_PRICE_ID is optional; without it the checkout
# route creates an inline one-time payment price.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""

# Polar fallback. Product ID is required for Polar checkout creation.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRO_PRODUCT_ID=""

# ---------------------------------------------------------------------------
# Media storage — S3-compatible (Cloudflare R2 or Amazon S3)
# ---------------------------------------------------------------------------
S3_BUCKET="agentmesh-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# R2: "auto"  |  AWS: e.g. "us-east-1"
S3_REGION="auto"
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Amazon S3: leave blank to use the default AWS endpoint
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# Public base URL objects are served from (R2 public domain, CloudFront, or custom domain)
S3_PUBLIC_BASE_URL="https://media.example.com"
# Set "true" for R2 / MinIO style path-based addressing
S3_FORCE_PATH_STYLE="true"
# Optional canned ACL for AWS (e.g. "public-read"); R2 ignores this
# S3_ACL="public-read"

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID. When unset, GA4 is not loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# PostHog project key + host. When the key is unset, PostHog is not loaded.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
